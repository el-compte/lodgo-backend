# Application
NODE_ENV=development
PORT=4000

# Database
MONGODB_URI=mongodb://localhost:27017/devWaves

# JWT
JWT_SECRET=change-this-to-a-secure-random-string-in-production
JWT_EXPIRATION=24h

# CORS
CLIENT_URL=http://localhost:3001

# AWS Cognito Configuration
AWS_REGION=us-east-1
AWS_COGNITO_CLIENT_ID=your-cognito-client-id-here
AWS_COGNITO_CLIENT_SECRET=your-cognito-client-secret-here
AWS_COGNITO_USER_POOL_ID=us-east-1_xxxxxxxxx
AWS_COGNITO_DOMAIN=your-cognito-domain
AWS_ACCESS_KEY_ID=your-aws-access-key-here
AWS_SECRET_ACCESS_KEY=your-aws-secret-key-here

# Cognito Callback URLs
COGNITO_CALLBACK_URL=http://localhost:4000/auth/cognito/callback
COGNITO_LOGOUT_URL=http://localhost:3001

# Optional: Cognito Identity Pool
AWS_COGNITO_IDENTITY_POOL_ID=your-identity-pool-id-here

# Optional: Email Configuration (if using Cognito email)
COGNITO_FROM_EMAIL=noreply@yourdomain.com
