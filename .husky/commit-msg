#!/bin/sh

BRANCH_NAME=$(git symbolic-ref --short HEAD)

PATTERN="^(feat|fix|chore|docs|refactor|test|perf|ci|build)/[A-Z]+-[0-9]+(-[a-z0-9-]+)?$"

if ! echo "$BRANCH_NAME" | grep -Eq "$PATTERN"; then
  echo "❌ Invalid branch name: $BRANCH_NAME"
  echo ""
  echo "Branch names must follow the format:"
  echo "  <type>/<TICKET-ID>-<description>"
  echo "Examples:"
  echo "  docs/SCRUM-115-update-readme"
  echo "  feat/BOOK-123-add-login"
  echo "  fix/BUG-98-payment-timeout"
  echo ""
  echo "Where <type> is one of: feat, fix, chore, docs, refactor, test, perf, ci, build"
  echo "      <TICKET-ID> is your ticket reference (e.g., SCRUM-115)"
  echo "      <description> is a short, kebab-case summary"
  exit 1
fi